+                    chan->status = 0;
+                }
+                return;
+            }
+
+            if (samplesLeftInWav > (s32)totalAdvance) {
+                const float scaleR = (float)envR * (1.0f / 32768.0f);
+                const float scaleL = (float)envL * (1.0f / 32768.0f);
+                const s8 *src = current;
+                s32 b = src[0];
+                s32 m = src[1] - b;
+                float bF = (float)b;
+                float mScaled = (float)m * kInvFracScale;
+
+                for (u16 i = 0; i < samplesPerFrame; i++, outBuffer += 2) {
+                    float sample = (float)(int32_t)phase * mScaled + bF;
+                    outBuffer[1] += sample * scaleR;
+                    outBuffer[0] += sample * scaleL;
+
+                    phase += step;
+                    uint32_t coarse = phase >> kFracBits;
+                    if (coarse != 0) {
+                        phase &= kFracMask;
+                        src += coarse;
+                        b = src[0];
+                        m = src[1] - b;
+                        bF = (float)b;
+                        mScaled = (float)m * kInvFracScale;
+                    }
+                }
+
+                chan->fw = (float)phase * kInvFracScale;
+                chan->ct = samplesLeftInWav - (s32)totalAdvance;
+                chan->current = (s8 *)src;
+                return;
+            }
+        }
+
         const float scaleR = (float)envR * (1.0f / 32768.0f);
         const float scaleL = (float)envL * (1.0f / 32768.0f);
 
